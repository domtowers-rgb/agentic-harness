# agentic-harness settings. Copy this file to .env (same folder) and edit:
#   cp .env.example .env
# .env is read at startup and is gitignored - keep real keys there, never
# in this file. A variable set in the real environment overrides .env.
# Lines starting with # are ignored; uncomment a setting to change it.

# --- Model backend ---------------------------------------------------------
# "openai" = any OpenAI-compatible server (LM Studio, Ollama, llama.cpp,
# or the real OpenAI API); "mock" = a test echo model.
AGENTIC_MODEL=openai
# Your local server's address (LM Studio's default port is 1234). Leave
# unset to use the real OpenAI API. The web UI's settings panel can still
# switch this while running.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# Model used when a request doesn't name one - set to a model your server
# has. Signal chats can pick their own with /model.
# AGENTIC_DEFAULT_MODEL=gpt-4o-mini
# Only needed for the real OpenAI API; local servers ignore it.
# OPENAI_API_KEY=

# --- Server ----------------------------------------------------------------
# PORT=8000
# Auto-restart on code changes (development only).
# AGENTIC_RELOAD=0

# --- Generation and history ------------------------------------------------
# AGENTIC_DEFAULT_MAX_TOKENS=2048
# Rough history budget in tokens - roughly match your model's context size.
# AGENTIC_HISTORY_MAX_TOKENS=2048
# AGENTIC_MAX_TOOL_ITERATIONS=8
# Personality/system prompt file.
# AGENTIC_PERSONALITY_FILE=SOUL.md

# --- Tools -----------------------------------------------------------------
# Web search: a free key from https://brave.com/search/api/
BRAVE_API_KEY=
# Sandbox folder for file tools, created documents and uploads.
# AGENTIC_FILES_DIR=workspace
# Lets the model run shell commands - real system access. Off unless 1.
# AGENTIC_ENABLE_SHELL=0
# Max characters returned per fetch_url / read_document call.
# AGENTIC_FETCH_MAX_CHARS=8000
# AGENTIC_READ_MAX_CHARS=8000
# Largest uploaded file accepted, in bytes (default 25 MB).
# AGENTIC_MAX_UPLOAD_BYTES=26214400
# Log of every tool call (local only).
# AGENTIC_AUDIT_LOG=audit.log
